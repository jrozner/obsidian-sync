# Copy to .env and edit. `docker compose` auto-loads .env for every project.
#
# .env holds only the SHARED constants below. The per-vault values —
# COMPOSE_PROJECT_NAME and VAULT_PATH — are set per project in your shell:
#
#   export COMPOSE_PROJECT_NAME=whoop
#   export VAULT_PATH=/home/jrozner/vuln-research/whoop/wiki
#
# (Exported shell vars override .env, so a per-project VAULT_PATH wins.)

# Own vault files as this user. `id -u` / `id -g`.
PUID=1000
PGID=1000

# Pin the beta CLI version (the shared image tag).
OB_VERSION=0.0.12

# Optional per-project override. Lets a project's container start already
# authenticated instead of running `ob login`. Grab it after an interactive
# login (with COMPOSE_PROJECT_NAME set) via:
#   docker compose run --rm --entrypoint sh obsidian-sync -c 'cat /config/obsidian-headless/auth_token'
# Treat it like a password. Set per project, not here.
# OBSIDIAN_AUTH_TOKEN=
