# Copy to .env and edit. `docker compose` reads .env automatically.

# Absolute path to the vault on the host.
VAULT_PATH=/home/jrozner/vaults/my-vault

# Own vault files as this user. `id -u` / `id -g`.
PUID=1000
PGID=1000

# Pin the beta CLI version.
OB_VERSION=0.0.12

# Optional. Lets the container start already authenticated instead of running
# `ob login`. Grab it after an interactive login with:
#   docker compose run --rm --entrypoint sh obsidian-sync -c 'cat /config/obsidian-headless/auth_token'
# Treat it like a password.
# OBSIDIAN_AUTH_TOKEN=
